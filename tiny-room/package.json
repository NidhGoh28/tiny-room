{
  "name": "tiny-room",
  "productName": "Tiny Room",
  "version": "1.0.0",
  "description": "A pixel bedroom on your desktop that shows how your Mac is doing",
  "main": "main.js",
  "author": "NidhGoh28",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "mac": "electron-packager . \"Tiny Room\" --platform=darwin --electron-version=33.4.11 --icon=build/icon.icns --out=dist --overwrite --app-bundle-id=io.github.nidhgoh28.tinyroom --app-version=1.0.0 --ignore=^/dist --ignore=^/build --ignore=^/node_modules"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "@electron/packager": "18.4.4"
  },
  "engines": { "node": ">=16.13" }
}
